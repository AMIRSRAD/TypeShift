{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeShift",
  "version": "0.1.0",
  "identifier": "com.typeshift.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TypeShift",
        "width": 1180,
        "height": 760,
        "center": true,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Local image and media converter",
    "longDescription": "Convert images locally with metadata controls and HDR-aware HEIC support. Video and audio workspaces are available where their external tools are installed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "TypeShift"
      }
    }
  }
}
